*.png
# ...except the images the app itself loads (only screenshots are kept out)
!app/assets/**/*.png
*.pdf
*.log
quilt_dbg.html
pdfprev/
blender/
quilt_render_pkg/
blocks12/
node_modules/
dist/
# the folder that goes online (npm run publish:page -w @quilt/app)
app/publish/
test-results/
playwright-report/
coverage/

# the server's local settings
server/.env

# development photo storage (STORAGE=local)
server/.data/

# the block review sheet (node shared/tools/block-sheet.mjs)
/block-sheet.html

# review pages made by shared/tools/drawing-review.mjs (they hold the pictures)
/drawing-review*.html
/diagram-review*.html

# GIF copies of the clips (the page uses the jpg, mp4 and webm)
app/assets/clips/*.gif
# the phone app's icons and start screens are pictures to keep, not screenshots
!mobile/assets/*.png
!mobile/android/app/src/main/res/**/*.png
!mobile/ios/App/App/Assets.xcassets/**/*.png

# the page's Sentry address for deploy.ps1, kept on this computer only
.deploy-sentry-dsn
