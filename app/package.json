{
  "name": "@quilt/app",
  "private": true,
  "scripts": {
    "build": "python3 build.py",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.mjs\"",
    "lint": "eslint src tests",
    "typecheck": "tsc -p ../jsconfig.json",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' \"tests/unit/*.test.mjs\"",
    "coverage:e2e": "rm -rf coverage/e2e && COVERAGE=1 python3 build.py && COVERAGE=1 playwright test; python3 build.py"
  },
  "dependencies": {
    "@quilt/shared": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "monocart-coverage-reports": "^2.13.2",
    "three": "^0.183.2",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.14"
  }
}
