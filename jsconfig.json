{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "shared/src/*.js",
    "app/src/core/*.js",
    "app/src/cutting/plan.js",
    "app/src/storage/idb.js",
    "app/src/storage/repo.js",
    "app/src/storage/migrate.js",
    "server/src/**/*.js",
    "server/src/*.d.ts"
  ]
}
