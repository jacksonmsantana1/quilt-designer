{
  "name": "quilt",
  "private": true,
  "workspaces": [
    "shared",
    "app",
    "server",
    "mobile"
  ],
  "scripts": {
    "build": "npm run build -w @quilt/app",
    "format": "prettier --write \"mobile/src/**/*.js\" \"mobile/*.mjs\" \"mobile/tests/**/*.mjs\" \"app/src/**/*.js\" \"app/tests/**/*.mjs\" \"shared/**/*.{js,mjs}\" \"server/**/*.js\"",
    "format:check": "prettier --check \"mobile/src/**/*.js\" \"mobile/*.mjs\" \"mobile/tests/**/*.mjs\" \"app/src/**/*.js\" \"app/tests/**/*.mjs\" \"shared/**/*.{js,mjs}\" \"server/**/*.js\"",
    "lint": "eslint app/src app/tests shared server mobile",
    "typecheck": "tsc -p jsconfig.json",
    "test": "npm test -w @quilt/shared && npm test -w @quilt/app && npm test -w @quilt/server",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:e2e": "npm run test:e2e -w @quilt/app && npm run test:e2e -w @quilt/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
