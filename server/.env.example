# Copy to server/.env for `npm run dev -w @quilt/server`. The values below match docker-compose.yml.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://quilt:quilt@localhost:5432/quilt
# sign-in:
#   auth0  tokens from Auth0 (the app's "Sign in" button); the default when AUTH0_DOMAIN is set
#   dev    the stand-in login (X-Dev-User header), plus Auth0 tokens when AUTH0_DOMAIN is set. Only when asked for
#          here, and refused in production.
AUTH_MODE=dev
# the Auth0 tenant, and the identifier of this API there (Auth0 dashboard: Applications > APIs)
AUTH0_DOMAIN=dev-5op4uervqyekvlsx.us.auth0.com
AUTH0_AUDIENCE=https://api.quilt-designer
# where the app is served from in development (several: comma-separated)
CORS_ORIGINS=http://localhost:8000
# photo storage:
#   STORAGE=local  a folder served by the API itself (development only; the default when S3_ENDPOINT is not set)
#   STORAGE=s3     SeaweedFS in development (docker compose), Cloudflare R2 in production
#                  (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=false)
STORAGE=s3
LOCAL_STORAGE_DIR=.data/photos
PUBLIC_URL=http://localhost:8787
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=quilt-fabrics
S3_ACCESS_KEY_ID=quilt
S3_SECRET_ACCESS_KEY=quilt-dev-secret
S3_FORCE_PATH_STYLE=true
# limits (these are the defaults). Requests a minute per person: 6000 with AUTH_MODE=dev, for the seed script
# RATE_LIMIT_PER_MINUTE=600
# MAX_PHOTO_MB_PER_PERSON=1024
# MAX_DESIGNS_PER_PERSON=2000
# MAX_SHARED_PER_PERSON=200
# behind a host's proxy, the header holding the visitor's address (Fly.io: fly-client-ip). Only one the proxy always
# sets itself: otherwise anyone could send it and escape the limits
# CLIENT_IP_HEADER=
